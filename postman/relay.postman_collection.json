    {
      "name": "3. Message service (internal)",
      "description": "Dialog membership is resolved server-side and ends up as `recipientIds` on the `messages.delivery` event, which is what the websocket gateway fans out on. A client never names its own recipients.\n\nThe `clientMessageId` requests below are the important ones: they demonstrate that a repeated send is recognised rather than stored twice, which is what makes a client's REST fallback safe after a lost socket acknowledgement.",
      "item": [
        {
          "name": "Create dialog (A + B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('dialogId', json.id);",
                  "console.log('dialogId =', json.id);",
                  "",
                  "pm.test('both users are participants', () => {",
                  "  pm.expect(json.participantIds).to.include(pm.collectionVariables.get('userIdA'));",
                  "  pm.expect(json.participantIds).to.include(pm.collectionVariables.get('userIdB'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\"{{userIdA}}\", \"{{userIdB}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/dialogs",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "dialogs"
              ]
            },
            "description": "Keep the returned id — it is the payload.dialog_id for message.send over the socket too."
          }
        },
