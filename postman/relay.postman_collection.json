  "item": [
    {
      "name": "0. Health",
      "description": "Confirms the pieces this collection depends on are actually up.",
      "item": [
        {
          "name": "Eureka - registered services",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('eureka is up', () => pm.response.to.have.status(200));",
                  "",
                  "const apps = pm.response.json().applications.application || [];",
                  "const names = (Array.isArray(apps) ? apps : [apps]).map(a => a.name);",
                  "console.log('registered:', names.join(', '));",
                  "",
                  "// message-service registers itself; sends travel over Kafka, not lb://",
                  "pm.test('message is registered', () => pm.expect(names).to.include('MESSAGE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{eurekaUrl}}/eureka/apps",
              "host": [
                "{{eurekaUrl}}"
              ],
              "path": [
                "eureka",
                "apps"
              ]
            },
            "description": "Lists what has registered with Eureka. Registration is required for future REST routing (history API through the api-gateway); the WebSocket send path itself travels over Kafka and does not use discovery."
          }
        },
        {
          "name": "Keycloak - realm discovery",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('relay-realm exists', () => pm.response.to.have.status(200));",
                  "pm.test('issuer matches what the services expect', () =>",
                  "  pm.expect(pm.response.json().issuer).to.eql('http://localhost:8081/realms/relay-realm'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/relay-realm/.well-known/openid-configuration",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "relay-realm",
                ".well-known",
                "openid-configuration"
              ]
            },
            "description": "The websocket gateway and api-gateway both validate tokens against this realm's JWKS."
          }
        }
      ]
    },
    {
      "name": "1. Auth (through api-gateway)",
      "description": "`/api/v1/auth/**` is the only path the api-gateway lets through unauthenticated.\n\nRegister does two things: it creates the Keycloak identity and then saves the profile in user-service. If the profile save fails, the Keycloak user is deleted again, so registration never leaves an identity without a profile.",
      "item": [
        {
          "name": "Register user A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh address every run, so the collection can be re-run without 409s.",
                  "pm.collectionVariables.set('emailA', `alice+${Date.now()}@relay.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('returns tokens - register logs you straight in', () =>",
                  "  pm.expect(json.access_token).to.be.a('string'));",
                  "",
                  "pm.collectionVariables.set('accessTokenA', json.access_token);",
                  "pm.collectionVariables.set('refreshTokenA', json.refresh_token);",
                  "",
                  "// The Keycloak user id is the token's `sub`. Everything downstream keys on it:",
                  "// it is the user-service profile id, the dialog participant id and the senderId.",
                  "const claims = JSON.parse(Buffer.from(json.access_token.split('.')[1], 'base64').toString('utf8'));",
                  "pm.collectionVariables.set('userIdA', claims.sub);",
                  "console.log('userIdA =', claims.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Anderson\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Password rules (8-256 chars, upper, lower, digit, special) are declared on RegisterRequest but the controller has no @Valid, so they are not currently enforced by auth — Keycloak's own policy decides. `Relay!2345` satisfies both."
          }
        },
        {
          "name": "Login user A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessTokenA', json.access_token);",
                  "pm.collectionVariables.set('refreshTokenA', json.refresh_token);",
                  "",
                  "pm.test('token is a bearer token', () => pm.expect(json.token_type.toLowerCase()).to.eql('bearer'));",
                  "",
                  "const claims = JSON.parse(Buffer.from(json.access_token.split('.')[1], 'base64').toString('utf8'));",
                  "pm.collectionVariables.set('userIdA', claims.sub);",
                  "pm.test('sub matches the registered user', () =>",
                  "  pm.expect(claims.sub).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register user B",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailB', `bob+${Date.now()}@relay.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessTokenB', json.access_token);",
                  "",
                  "const claims = JSON.parse(Buffer.from(json.access_token.split('.')[1], 'base64').toString('utf8'));",
                  "pm.collectionVariables.set('userIdB', claims.sub);",
                  "console.log('userIdB =', claims.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Brown\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "A second user, so you have a real counterpart for chats and for watching delivery over two sockets."
          }
        },
        {
          "name": "Register duplicate email (expect failure)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected, not silently duplicated', () =>",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 409, 500]));",
                  "console.log('status', pm.response.code, pm.response.text().slice(0, 200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Duplicate\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Keycloak refuses the duplicate username before user-service is ever called, so no orphan profile is created. The exact status comes from Keycloak's error mapping."
          }
        },
        {
          "name": "Refresh user A token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessTokenA', json.access_token);",
                  "pm.collectionVariables.set('refreshTokenA', json.refresh_token);",
                  "pm.test('new access token issued', () => pm.expect(json.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshTokenA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/refresh",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. User service (internal)",
      "description": "`/internal/**` is service-to-service: it is permitted without a token and is deliberately not routed by the api-gateway. Called here directly on `userServiceUrl`.",
      "item": [
        {
          "name": "Get profile A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK - registration created the profile', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('profile is keyed by the Keycloak user id', () =>",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('userIdA')));",
                  "pm.test('email matches the registration', () =>",
                  "  pm.expect(json.email).to.eql(pm.collectionVariables.get('emailA')));",
                  "pm.test('names were carried across', () => {",
                  "  pm.expect(json.firstName).to.eql('Alice');",
                  "  pm.expect(json.lastName).to.eql('Anderson');",
                  "});"
                ]
              }
            }
          ],
