        },
        {
          "name": "Send message as A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh client-side id per send. The next request deliberately reuses it.",
                  "pm.collectionVariables.set('clientMessageId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created - stored for the first time', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('messageId', json.id);",
                  "",
                  "pm.test('echoes clientMessageId so the sender can reconcile', () =>",
                  "  pm.expect(json.clientMessageId).to.eql(pm.collectionVariables.get('clientMessageId')));",
                  "pm.test('sender is A', () => pm.expect(json.senderId).to.eql(pm.collectionVariables.get('userIdA')));",
                  "pm.test('has a server-assigned id and timestamp', () => {",
                  "  pm.expect(json.id).to.be.a('string');",
                  "  pm.expect(json.sentAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{clientMessageId}}\",\n  \"dialogId\": \"{{dialogId}}\",\n  \"senderId\": \"{{userIdA}}\",\n  \"text\": \"hello from postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "messages"
              ]
            },
            "description": "This also publishes `messages.delivery` to Kafka after the transaction commits. If a socket is open for A or B, they receive a MESSAGE_NEW frame from this request. You can see the event in kafka-ui at http://localhost:8082."
          }
        },
        {
          "name": "Send the same message again (idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK, not 201 - recognised as a retry', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('returns the message that already exists', () =>",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('messageId')));",
                  "",
                  "// No second messages.delivery is published, so nobody sees the message twice."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{clientMessageId}}\",\n  \"dialogId\": \"{{dialogId}}\",\n  \"senderId\": \"{{userIdA}}\",\n  \"text\": \"hello from postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "messages"
              ]
            },
            "description": "The exact same body as the previous request. This is what a client's REST fallback looks like after a WebSocket send succeeded but its acknowledgement was lost. It must return the stored message rather than create a second one, and must not re-announce it."
          }
        },
        {
          "name": "Same clientMessageId in another dialog (expect 200 - sender-scoped dedup)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A second chat, so the same clientMessageId can be shown to be dialog-scoped.",
                  "const res = pm.sendRequest({",
                  "  url: pm.collectionVariables.get('messageServiceUrl') + '/internal/api/v1/dialogs',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ participantIds: [",
                  "    pm.collectionVariables.get('userIdA'), pm.collectionVariables.get('userIdB')",
                  "  ]}) }",
                  "}, (err, response) => {",
                  "  if (err) { console.error(err); return; }",
                  "  pm.collectionVariables.set('secondDialogId', response.json().id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK - recognised as a retry, dedup is sender-scoped', () => pm.response.to.have.status(200));",
                  "pm.test('returns the original message, not a new one', () =>",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('messageId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{clientMessageId}}\",\n  \"dialogId\": \"{{secondDialogId}}\",\n  \"senderId\": \"{{userIdA}}\",\n  \"text\": \"same client id, different dialog\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "messages"
              ]
            },
            "description": "The unique constraint is (sender_id, client_message_id) per ARCHITECTURE.md §19.2 — the client owns its UUID space outright. So the same clientMessageId from the same sender is a recognised retry even in a different dialog: the stored original is returned with 200, and nothing new is created or announced."
          }
        },
        {
          "name": "Send as non-participant (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('explains the sender is not in the dialog', () =>",
                  "  pm.expect(pm.response.text()).to.include('participant'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{$guid}}\",\n  \"dialogId\": \"{{dialogId}}\",\n  \"senderId\": \"99999999-9999-9999-9999-999999999999\",\n  \"text\": \"I should not be able to post here\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "messages"
              ]
            },
            "description": "Membership is checked server-side. Without this, anything that could reach `/internal` could post into any conversation — which is also why this path must never be exposed through the api-gateway."
          }
        },
        {
          "name": "Send to unknown dialog (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "// Over a socket this same failure arrives as {\"type\":\"ERROR\",\"code\":\"SEND_FAILED\",...}",
                  "// carrying the clientMessageId, so the client knows which send to retry."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{$guid}}\",\n  \"dialogId\": \"00000000-0000-0000-0000-000000000000\",\n  \"senderId\": \"{{userIdA}}\",\n  \"text\": \"no such chat\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Send with malformed dialog id (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{$guid}}\",\n  \"dialogId\": \"not-a-uuid\",\n  \"senderId\": \"{{userIdA}}\",\n  \"text\": \"bad dialog id\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
              "host": [
                "{{messageServiceUrl}}"
              ],
              "path": [
                "internal",
                "api",
                "v1",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Send with blank body (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('names the offending field', () => pm.expect(pm.response.text()).to.include('text'));"
                ]
              }
