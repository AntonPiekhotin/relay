        }
      ]
    },
    {
      "name": "4. Security boundaries",
      "description": "Checks that the things which are supposed to be closed actually are.",
      "item": [
        {
          "name": "Gateway rejects a request with no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "// Only /api/v1/auth/** is public at the gateway; everything else needs a JWT."
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/user/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                "me"
              ]
            },
            "description": "There is no public user endpoint yet, so with a token this would 404 rather than 200. The point here is the 401 without one."
          }
        },
        {
          "name": "Gateway does not expose /internal paths",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not reachable through the gateway', () =>",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 403, 404]));",
                  "",
                  "pm.test('did not create anything', () =>",
                  "  pm.expect(pm.response.code).to.not.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\"{{userIdA}}\", \"{{userIdB}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/message/internal/api/v1/dialogs",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "message",
                "internal",
                "api",
                "v1",
                "dialogs"
              ]
            },
            "description": "With Spring Cloud Gateway's discovery locator enabled, every registered service gets an automatic `/{serviceId}/**` route, which would re-expose these internal paths. The locator is disabled, so this must not succeed."
          }
        },
        {
          "name": "WebSocket handshake without a token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized before any upgrade', () => pm.response.to.have.status(401));",
                  "// Authentication runs on the handshake, so a bad token never gets a socket at all."
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Connection",
                "value": "Upgrade"
              },
              {
                "key": "Upgrade",
                "value": "websocket"
              },
              {
                "key": "Sec-WebSocket-Version",
                "value": "13"
              },
              {
                "key": "Sec-WebSocket-Key",
                "value": "dGhlIHNhbXBsZSBub25jZQ=="
              }
            ],
            "url": {
              "raw": "{{wsGatewayUrl}}/ws",
              "host": [
                "{{wsGatewayUrl}}"
              ],
              "path": [
                "ws"
              ]
            }
          }
        },
        {
          "name": "WebSocket handshake with a bad token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Connection",
                "value": "Upgrade"
              },
              {
                "key": "Upgrade",
                "value": "websocket"
              },
              {
                "key": "Sec-WebSocket-Version",
                "value": "13"
              },
              {
                "key": "Sec-WebSocket-Key",
                "value": "dGhlIHNhbXBsZSBub25jZQ=="
              },
              {
                "key": "Sec-WebSocket-Protocol",
                "value": "access_token, not.a.real.jwt"
              }
            ],
            "url": {
              "raw": "{{wsGatewayUrl}}/ws",
              "host": [
                "{{wsGatewayUrl}}"
              ],
              "path": [
                "ws"
              ]
            },
            "description": "The token travels in the subprotocol list because browsers cannot set headers on a WebSocket handshake. An unverifiable token is refused here, not after connecting."
          }
        }
      ]
    },
    {
