              "raw": "{\n  \"clientMessageId\": \"{{$guid}}\",\n  \"dialogId\": \"{{dialogId}}\",\n  \"senderId\": \"{{userIdA}}\",\n  \"text\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{messageServiceUrl}}/internal/api/v1/messages",
