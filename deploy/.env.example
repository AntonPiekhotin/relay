# Copy to deploy/.env, fill in, `chmod 600`. deploy/.env is gitignored (the root .gitignore's
# `.env` rule has no slash, so it matches at any depth).
#
# Generate every secret below with `openssl rand -base64 36 | tr -d '/+=' | head -c 40`.
# None of them may be a value that has ever been in the repo.

# ── images ──────────────────────────────────────────────────────────────────────────────────
# Set RELAY_IMAGE_TAG to the tag scripts/build-images.sh printed. `latest` works but makes a
# rollback impossible to describe.
RELAY_REGISTRY=relay
RELAY_IMAGE_TAG=latest

# ── hostnames ───────────────────────────────────────────────────────────────────────────────
# Four A records, all pointing at PUBLIC_IP.
API_HOST=api.example.com          # REST + the WebSocket upgrade on /ws
AUTH_HOST=auth.example.com        # Keycloak
SFU_HOST=sfu.example.com          # LiveKit signaling (wss). Media does NOT go through nginx.
KIBANA_HOST=logs.example.com      # locked to ADMIN_ALLOW_CIDR in nginx
TURN_HOST=turn.example.com        # coturn; also the realm name and the TLS cert subject

# The address clients must reach for media. Both coturn's --external-ip and LiveKit's node_ip
# come from here: they allocate inside the host and would otherwise advertise a private address,
# which presents as "signaling works, ICE completes, no audio".
PUBLIC_IP=203.0.113.10

LETSENCRYPT_EMAIL=you@example.com

# ── databases ───────────────────────────────────────────────────────────────────────────────
USER_DB_USER=relay_user
USER_DB_PASSWORD=
MESSAGE_DB_USER=relay_message
MESSAGE_DB_PASSWORD=
NOTIFICATION_DB_USER=relay_notification
NOTIFICATION_DB_PASSWORD=
CALL_DB_USER=relay_call
CALL_DB_PASSWORD=
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# ── identity ────────────────────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# MUST NOT be D0t5nQjQJAfrj7uSkChM6MkYpo1Mm2FA. That value is committed in
# auth/src/main/resources/application.yaml and was printed verbatim into log files by
# org.apache.http.headers before those levels were capped. Treat it as public.
# Set the new value here AND in Keycloak (clients -> relay-client -> credentials -> regenerate).
KEYCLOAK_CLIENT_SECRET=

# ── media plane ─────────────────────────────────────────────────────────────────────────────
# Signs every TURN credential. Not the dev default.
TURN_STATIC_AUTH_SECRET=
# LiveKit refuses a secret under 32 characters. It signs both room tokens and webhooks, so
# leaking it hands out call admission AND forged call-state transitions.
LIVEKIT_API_KEY=relay
LIVEKIT_API_SECRET=

# ── session registry ────────────────────────────────────────────────────────────────────────
# Nothing connects to Redis yet (build-order item 7). Set it anyway so that work cannot ship
# against an open instance by omission.
REDIS_PASSWORD=

# ── push ────────────────────────────────────────────────────────────────────────────────────
# Directory bind-mounted read-only at /run/secrets. Must contain fcm.json, and apns.p8 if APNs
# is enabled. Relative paths resolve from deploy/.
SECRETS_DIR=../secrets
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.relay.app
# sandbox | production — a token minted for one is rejected by the other, which surfaces as
# BadDeviceToken rather than as an environment mismatch.
APNS_ENVIRONMENT=production

# ── logging ─────────────────────────────────────────────────────────────────────────────────
ELASTIC_VERSION=8.17.4
# The `elastic` superuser. Also what logstash writes with.
ELASTIC_PASSWORD=
# Kibana's own service account. Applied to Elasticsearch by deploy/bootstrap-elk.sh — it cannot
# be set at bootstrap, only through the security API once the cluster is up.
KIBANA_SYSTEM_PASSWORD=
# >= 32 chars, and STABLE forever. Changing it discards every saved object, data views included.
KIBANA_ENCRYPTION_KEY=

# ── access control ──────────────────────────────────────────────────────────────────────────
# Source range allowed to reach Kibana. Leave it narrow; the index holds every log line the
# system produces. `0.0.0.0/0` here would publish your logs.
ADMIN_ALLOW_CIDR=203.0.113.0/24
